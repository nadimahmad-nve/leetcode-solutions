class TreeNode:
    def __init__(self, val=0, left=None, right=None):
        self.val = val
        self.left = left
        self.right = right

class Solution:
    def preorderTraversal(self, root: TreeNode | None) -> list[int]:
        result = []

        def traverse(root): 
            nonlocal result 
            
            if root == None:
                return 
            
            result.append(root.val)
            traverse(root.left)
            traverse(root.right)
        
        
        traverse(root)

        return result 